# Postgres connection used by the app at runtime (pooled connection string on Neon).
DATABASE_URL="postgresql://ajaia:ajaia@localhost:5432/ajaia"

# Direct (unpooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://ajaia:ajaia@localhost:5432/ajaia"

# Secret used to sign the session cookie (HS256). At least 32 characters.
SESSION_SECRET="local-dev-secret-change-me-32-chars-min"
